{
  "name": "smart-assert",
  "version": "0.1.0",
  "private": true,
  "description": "LLM-as-a-judge semantic assertions for API testing (Master's capstone)",
  "scripts": {
    "test": "playwright test -c playwright.unit.config.ts",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:api": "tsx scripts/test-api.ts",
    "test:api:subscription": "tsx scripts/test-api.ts --subscription",
    "test:api:smoke": "playwright test -c playwright.api.config.ts --grep @smoke",
    "capture": "playwright test -c playwright.api.config.ts --grep @capture",
    "save:responses": "playwright test -c playwright.api.config.ts --grep @save-response",
    "experiment": "tsx src/experiments/run-experiment.ts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  }
}
