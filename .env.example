# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=
# Judge model for experiments: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
JUDGE_MODEL=claude-opus-5-5

# Onixwork test API (live tests). Short-lived token from POST /v1/Account/token.
ONIX_BASE_URL=https://openapi-test.onixwork.com
ONIX_USERNAME=
ONIX_PASSWORD=
# TLS certificate verification. Leave true unless you knowingly accept the risk.
ONIX_VERIFY_TLS=true
