# Copy this file to .env and fill it in. Never commit .env.
ANTHROPIC_API_KEY=
# Judge model for experiments: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
JUDGE_MODEL=claude-opus-5-5
# Judge backend: api (default, uses ANTHROPIC_API_KEY) | claude-code (dev only: runs Claude Code
# headless on your Pro/Max subscription; not for measured experiment runs)
JUDGE_BACKEND=api

# Onix Work test API (live tests). Short-lived token from POST /v1/Account/token.
ONIX_WORK_API_BASE_URL=https://openapi-test.onixwork.com
ONIX_WORK_USERNAME=
ONIX_WORK_PASSWORD=
# Optional: long-lived key from Onix Work settings, sent as "Authorization: Key <apiKey>".
ONIX_WORK_API_KEY=
# TLS certificate verification. Leave true unless you knowingly accept the risk
# (the test server's certificate is expired at the moment, so live tests need false).
ONIX_VERIFY_TLS=true
